# --- Base de datos ---
# Sin DATABASE_URL la app usa PGlite: un PostgreSQL dentro del proyecto (carpeta .data/).
# Para producción pon la URL de un PostgreSQL real (por ejemplo uno gratis de https://neon.tech):
# DATABASE_URL="postgresql://usuario:password@host:5432/corte"

# --- Iniciar sesión con Google (opcional) ---
# Se sacan de https://console.cloud.google.com/auth/clients
# Si no los pones, el botón de Google no aparece.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Solo en producción si la URL pública no se detecta sola, por ejemplo https://corte.vercel.app
# APP_URL=""
